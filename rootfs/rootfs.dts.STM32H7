/dts-v1/;
#include "stm32h743.dtsi"
#include "stm32h7-pinctrl.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "STM32H7 SOM Starter Kit";
	compatible = "st,stm32h7-som", "st,stm32h743";

	chosen {
		stdout-path = "serial2:115200n8";
	};

	memory {
		device_type = "memory";
		/* The size is dynamically adjusted by U-Boot for 64MB module */
		reg = <0xd0000000 0x2000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* The framebuffer should be shared between U-Boot and Linux
		   to avoid "display glitches" during boot-up */
		framebuffer {
			reg = <0xd1c00000 0x300000>;
			no-map;
		};

		/* The DMA memory pool is needed by Ethernet and other drivers
		   to allocate buffer descriptors using the standard DMA API */
		dmapool {
			compatible = "shared-dma-pool";
			reg = <0xd1f00000 0x100000>;
			no-map;
			linux,dma-default;
		};
	};

	aliases {
		serial1 = &usart2;
		serial2 = &usart3;
		serial3 = &uart4;
		serial5 = &usart6;
	};

	leds {
		compatible = "gpio-leds";
		user-led-1 {
			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
		};
		user-led-2 {
			gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		button-1 {
			label = "user-button-1";
			linux,code = <KEY_A>;
			gpios = <&gpioh 2 GPIO_ACTIVE_LOW>;
			gpio-key,wakeup;
		};
		button-2 {
			label = "user-button-2";
			linux,code = <KEY_B>;
			gpios = <&gpioh 3 GPIO_ACTIVE_LOW>;
		};
	};

	v3v3: v3v3 {
		compatible = "regulator-fixed";
		regulator-name = "v3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	vdd: vdd {
		compatible = "regulator-fixed";
		regulator-name = "vdd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&clk_hse {
	clock-frequency = <25000000>;
};

&usart3 {
	pinctrl-0 = <&usart3_pins_b>;
	pinctrl-names = "default";
	status = "okay";
};

&mac {
	status = "okay";
	pinctrl-0	= <&ethernet_rmii>;
	pinctrl-names	= "default";
	phy-mode	= "rmii";
	phy-handle	= <&phy0>;

	mdio0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";
		phy0: ethernet-phy@0 {
			reg = <1>;
		};
	};
};

&sdmmc1 {
	pinctrl-names = "default", "opendrain", "sleep";
	pinctrl-0 = <&sdmmc1_b4_pins_a>;
	pinctrl-1 = <&sdmmc1_b4_od_pins_a>;
	pinctrl-2 = <&sdmmc1_b4_sleep_pins_a>;

	cd-gpios = <&gpiog 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

	vmmc-supply = <&v3v3>;

	no-1-8-v;
	disable-wp;
	st,sdcard_highspeed_quirk;
	st,neg-edge;
	bus-width = <4>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins_a>;
	pinctrl-names = "default";
	status = "okay";
};

&usart6 {
	pinctrl-0 = <&usart6_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * MikroE Click
 */

&usart2 {
	pinctrl-0 = <&usart2_pins_b>;
	pinctrl-names = "default";
	uart-has-rtscts;
	status = "okay";
};

&i2c4 {
	pinctrl-0 = <&i2c4_pins_a>;
	pinctrl-names = "default";
	status = "okay";

	pressure@77 {
		compatible = "meas,ms5607";
		reg = <0x77>;
		status = "disabled";
	};
};

&spi4 {
	pinctrl-0 = <&spi4_pins>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 4 GPIO_ACTIVE_LOW>;
	status = "okay";

	pressure@0 {
		compatible = "meas,ms5607";
		reg = <0>;
		spi-max-frequency = <20000000>;
		status = "disabled";
	};
};

/*
 * M.2 Slot
 */

&gpiog {
	p9 {
		gpio-hog;
		gpios = <0x9 0x0>;
		output-high;
		line-name = "W_REG_EN1";
	};
	p10 {
		gpio-hog;
		gpios = <0xa 0x0>;
		output-high;
		line-name = "W_REG_EN2";
	};
};

&sdmmc2 {
	pinctrl-names = "default", "opendrain", "sleep";
	pinctrl-0 = <&sdmmc2_b4_pins_a>;
	pinctrl-1 = <&sdmmc2_b4_od_pins_a>;
	pinctrl-2 = <&sdmmc2_b4_sleep_pins_a>;

	vmmc-supply = <&v3v3>;
	vqmmc-supply = <&vdd>;

	non-removable;
	no-sd;
	st,neg-edge;
	bus-width = <4>;
	mmc-ddr-3_3v;
	status = "okay";
};

&uart4 {
	pinctrl-0 = <&uart4_pins_b>;
	pinctrl-names = "default";
	cts-gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;
	rts-gpios = <&gpioa 15 GPIO_ACTIVE_LOW>;
	status = "okay";
};

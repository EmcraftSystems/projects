# GDB server.
# Note that it is needed only if you want to debug applications on the target
# from the cross-GDB on the development host. If you do not anticipate
# the need to do so on production units in the field, comment out the line
# below to reduce the footprint of the target root file system.
file /usr/bin/gdbserver ${TARGET_ROOT}/usr/bin/gdbserver 755 0 0

# GUI tests and tools
file /usr/sbin/lcdtest ${INSTALL_ROOT}/projects/${SAMPLE}/lcdtest/lcdtest 777 0 0
file /usr/bin/ts_test ${INSTALL_ROOT}/projects/${SAMPLE}/lcdtest/ts_test 777 0 0
file /usr/bin/ts_calibrate ${TARGET_ROOT}/usr/bin/ts_calibrate 777 0 0
file /etc/ts.conf ${TARGET_ROOT}/etc/ts.conf 644 0 0
localdir /usr/lib/ts ${TARGET_ROOT}/usr/lib/ts 0 0
ifarch IMXRT105X_NXPEVK file /etc/pointercal ${INSTALL_ROOT}/projects/${SAMPLE}/etc/pointercal.imxrt1050-evk 777 0 0
ifarch STM32H7 file /etc/pointercal ${INSTALL_ROOT}/projects/${SAMPLE}/etc/pointercal.stm32h7-som 777 0 0
file /usr/sbin/evtest ${INSTALL_ROOT}/projects/${SAMPLE}/evtest/evtest 777 0 0

# Audio, supported on STM32F7/UCL-SOM-BSB
ifarch STM32F7 file /usr/bin/aplay ${INSTALL_ROOT}/A2F/root/usr/bin/aplay 777 0 0
ifarch STM32F7 file /usr/bin/amixer ${INSTALL_ROOT}/A2F/root/usr/bin/amixer 777 0 0
ifarch STM32F7 localdir /usr/share/alsa ${INSTALL_ROOT}/A2F/root/usr/share/alsa 0 0

# Mount partition and start GUI.
file /etc/guistart.sh ${INSTALL_ROOT}/projects/${SAMPLE}/etc/guistart.sh 777 0 0

# USB Gadget config script
file /usr/bin/usb_gadget.sh ${INSTALL_ROOT}/projects/${SAMPLE}/etc/usb_gadget.sh 755 0 0

# Shared libs
file /lib/ld-uClibc-1.0.47.so ${TARGET_ROOT}/lib/ld-uClibc-1.0.47.so 755 0 0
slink /lib/ld-uClibc.so.0 ld-uClibc.so.1 755 0 0
slink /lib/ld-uClibc.so.1 ld-uClibc-1.0.47.so 755 0 0
slink /usr/lib/ld.so.1 /lib/ld-uClibc.so.0 755 0 0
file /lib/libuClibc-1.0.47.so ${TARGET_ROOT}/lib/libuClibc-1.0.47.so 755 0 0
slink /lib/libc.so.0 libuClibc-1.0.47.so 755 0 0
file /lib/libgcc_s.so.1 ${TARGET_ROOT}/lib/libgcc_s.so.1 755 0 0
file /usr/lib/libstdc++.so.6.0.29 ${TARGET_ROOT}/usr/lib/libstdc++.so.6.0.29 755 0 0
slink /usr/lib/libstdc++.so libstdc++.so.6.0.29 755 0 0
slink /usr/lib/libstdc++.so.6 libstdc++.so.6.0.29 755 0 0

file /usr/lib/libts.so.0.10.4 ${TARGET_ROOT}/usr/lib/libts.so.0.10.4 755 0 0
slink /usr/lib/libts.so.0 libts.so.0.10.4 755 0 0
slink /usr/lib/libts.so libts.so.0 755 0 0

file /usr/lib/libubootenv.so.0.3.2 ${TARGET_ROOT}/usr/lib/libubootenv.so.0.3.2 755 0 0
slink /usr/lib/libubootenv.so.0 libubootenv.so.0.3.2 755 0 0
slink /usr/lib/libubootenv.so libubootenv.so.0 755 0 0

file /usr/lib/libz.so.1.2.12 ${TARGET_ROOT}/usr/lib/libz.so.1.2.12 755 0 0

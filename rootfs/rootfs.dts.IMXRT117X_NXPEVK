/dts-v1/;

#include "imxrt1170.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/imxrt1170-clock.h>
#include "imxrt1170-pinfunc.h"

/ {
	model = "NXP IMXRT1170 EVK board";
	compatible = "nxp,imxrt1170-evk", "fsl,imxrt1170", "fsl,imxrt1050";

	chosen {
		stdout-path = &lpuart1;
	};

	memory@80000000 {
		device_type = "memory";
		linux,usable-memory = <0x80000000 0x04000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		dmapool: dmapool@83b00000 {
			compatible = "shared-dma-pool";
			reg = <0x83b00000 0x100000>;
			no-map;
			linux,dma-default;
		};

		video_mem: memory@83c00000 {
			reg = <0x83c00000 0x400000>;
			no-map;
		};
	};

	aliases {
		serial0 = &lpuart1;
		ethernet0 = &fec1;
		ethernet1 = &fec_1g;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_leds>;
		user-led1 {
			label = "user-led1";
			gpios = <&gpio9 3 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		user-led2 {
			label = "user-led2";
			gpios = <&gpio9 25 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_keys>;

		user-button {
			label = "user-button";
			gpios = <&gpio13 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_A>;
		};
	};

	backlight {
		compatible = "gpio-backlight";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_backlight>;
		gpios = <&gpio9 29 GPIO_ACTIVE_HIGH>;
	};

	reg_lcd: regulator-lcd {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_mipi_dsi_pwr>;
		regulator-name = "lcd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&gpio11 16 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	mipi_dsi_reset: mipi-dsi-reset {
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_mipi_dsi_reset>;
		compatible = "gpio-reset";
		reset-gpios = <&gpio9 1 GPIO_ACTIVE_LOW>;
		reset-delay-us = <1000>;
		#reset-cells = <0>;
	};
};

&lpuart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpuart1>;
	status = "okay";
};

&gpt1 {
	status = "okay";
};

&fec1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec1>, <&pinctrl_fec1_lpsr>;
	status = "okay";

	assigned-clocks = <&clks IMXRT1170_CLK_ROOT_ENET1>;
	assigned-clock-parents = <&clks IMXRT1170_CLK_PLL1_DIV2>;
	assigned-clock-rates = <50000000>;
	fsl,ref-clk-dir = <&gpr 0x10 1 1>;

	phy-mode = "rmii";
	phy-handle = <&ethphy0>;
	phy-reset-duration = <1>;
	phy-reset-gpios = <&gpio12 12 GPIO_ACTIVE_LOW>;

	clocks = <&clks IMXRT1170_CLK_ROOT_BUS>, <&clks IMXRT1170_CLK_ROOT_BUS>, <&clks IMXRT1170_CLK_ENET1>;
	clock-names = "ipg", "ahb", "enet_clk_ref";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@0 {
			reg = <0>;
			micrel,kszphy-allow-broadcast-address;
			clocks = <&clks IMXRT1170_CLK_ENET1>;
			clock-names = "rmii-ref";
		};
	};
};

&fec_1g {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec_1g>;
	status = "okay";

	assigned-clocks = <&clks IMXRT1170_CLK_ROOT_ENET2>;
	assigned-clock-parents = <&clks IMXRT1170_CLK_PLL1_DIV2>;
	assigned-clock-rates = <125000000>;
	// This is used to enable ENET1G RGMII TX clock output
	// as the driver does not provide such a control
	fsl,ref-clk-dir = <&gpr 0x14 2 1>;

	phy-mode = "rgmii-id";
	phy-handle = <&ethphy1>;
	phy-reset-duration = <10>;
	phy-reset-post-delay = <50>;
	phy-reset-gpios = <&gpio11 14 GPIO_ACTIVE_LOW>;

	fsl,mii-exclusive;

	clocks = <&clks IMXRT1170_CLK_ROOT_BUS>, <&clks IMXRT1170_CLK_ROOT_BUS>, <&clks IMXRT1170_CLK_ENET2>;
	clock-names = "ipg", "ahb", "enet_clk_ref";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy1: ethernet-phy@1 {
			reg = <0>;
			clocks = <&clks IMXRT1170_CLK_ENET2>;
			clock-names = "rmii-ref";
		};
	};
};

&usdhc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc1>;
	status = "okay";
	/* do not configure cd-gpio due to pin conflict with ENET1:
	SD1_CD_B and ENET_MDC are both routed to GPIO_AD_32 on
	MIMXRT1170-EVK (SCH-32171) */
	broken-cd;
};

&usbotg1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usbotg1_id>;
	srp-disable;
	hnp-disable;
	adp-disable;
	disable-over-current;
	status = "okay";
};

&usbotg2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usbotg2_id>;
	srp-disable;
	hnp-disable;
	adp-disable;
	disable-over-current;
	status = "okay";
};

&mipi_dsi {
	lcd_panel = "ROCKTECH-RK055AHD091";

	resets = <&mipi_dsi_reset>;
	status = "okay";
};

&lcdif {
	status = "okay";
	disp-dev = "mipi_dsi_northwest";
	display = <&display0>;
	memory-region = <&video_mem>;

	display0: display@0 {
		bits-per-pixel = <16>;
		bus-width = <24>;
	};
};

&lpi2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpi2c5>;
	status = "okay";

	eeprom0: eeprom0@58 {
		compatible = "at,24c256";
		reg = <0x58>;
		status = "disabled";
	};

	goodix@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ctp>;
		interrupt-parent = <&gpio2>;
		interrupts = <31 IRQ_TYPE_EDGE_FALLING>;
		irq-gpios = <&gpio2 31 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio9 0 GPIO_ACTIVE_HIGH>;
		VDDIO-supply = <&reg_lcd>;
	};
};

&iomuxc {
	pinctrl_lpuart1: lpuart1grp {
		fsl,pins = <
			IOMUXC_GPIO_AD_24_LPUART1_TXD (MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_AD_25_LPUART1_RXD (MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
		>;
	};
	pinctrl_leds: ledsgrp {
		fsl,pins = <
			IOMUXC_GPIO_AD_04_GPIO9_IO03	(MXRT1170_PAD_DSE)
			IOMUXC_GPIO_AD_26_GPIO9_IO25	(MXRT1170_PAD_DSE)
		>;
	};
	pinctrl_fec1: fec1grp {
		fsl,pins = <
			IOMUXC_GPIO_AD_32_ENET_MDC		(MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_AD_33_ENET_MDIO		(MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_DISP_B2_02_ENET_TX_DATA00	(MXRT1170_PAD_DSE)
			IOMUXC_GPIO_DISP_B2_03_ENET_TX_DATA01	(MXRT1170_PAD_DSE)
			IOMUXC_GPIO_DISP_B2_04_ENET_TX_EN	(MXRT1170_PAD_DSE)
			IOMUXC_GPIO_DISP_B2_05_ENET_REF_CLK	(IMX_PAD_SION | MXRT1170_PAD_SRE | MXRT1170_PAD_DSE)
			IOMUXC_GPIO_DISP_B2_06_ENET_RX_DATA00	(IMX_PAD_SION | MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_DISP_B2_07_ENET_RX_DATA01	(IMX_PAD_SION | MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_DISP_B2_08_ENET_RX_EN	(MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_DISP_B2_09_ENET_RX_ER	(MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			/* INT */
			IOMUXC_GPIO_AD_12_GPIO9_IO11		(MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
		>;
	};
	pinctrl_fec_1g: fec1ggrp {
		fsl,pins = <
			IOMUXC_GPIO_EMC_B2_19_ENET_1G_MDC	 (MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_EMC_B2_20_ENET_1G_MDIO	 (MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)

			IOMUXC_GPIO_DISP_B1_00_ENET_1G_RX_EN	 (MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_DISP_B1_01_ENET_1G_RX_CLK	 (IMX_PAD_SION | MXRT1170_PAD_SRE | MXRT1170_PAD_DSE)
			IOMUXC_GPIO_DISP_B1_02_ENET_1G_RX_DATA00 (IMX_PAD_SION | MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_DISP_B1_03_ENET_1G_RX_DATA01 (IMX_PAD_SION | MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_DISP_B1_04_ENET_1G_RX_DATA02 (IMX_PAD_SION | MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_DISP_B1_05_ENET_1G_RX_DATA03 (IMX_PAD_SION | MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_DISP_B1_06_ENET_1G_TX_DATA03 (MXRT1170_PAD_DSE)
			IOMUXC_GPIO_DISP_B1_07_ENET_1G_TX_DATA02 (MXRT1170_PAD_DSE)
			IOMUXC_GPIO_DISP_B1_08_ENET_1G_TX_DATA01 (MXRT1170_PAD_DSE)
			IOMUXC_GPIO_DISP_B1_09_ENET_1G_TX_DATA00 (MXRT1170_PAD_DSE)
			IOMUXC_GPIO_DISP_B1_10_ENET_1G_TX_EN	 (MXRT1170_PAD_DSE)
			IOMUXC_GPIO_DISP_B1_11_ENET_1G_TX_CLK_IO (MXRT1170_PAD_DSE)

			/* INT */
			IOMUXC_GPIO_DISP_B2_12_GPIO11_IO13	 (MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			/* RST */
			IOMUXC_GPIO_DISP_B2_13_GPIO11_IO14	 (MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			IOMUXC_GPIO_AD_34_USDHC1_VSELECT	(MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
			IOMUXC_GPIO_SD_B1_00_USDHC1_CMD		(IMX_PAD_SION | MXRT1170_PAD_PULL_UP)
			IOMUXC_GPIO_SD_B1_01_USDHC1_CLK		(IMX_PAD_SION | MXRT1170_PAD_PULL_NO)
			IOMUXC_GPIO_SD_B1_05_USDHC1_DATA3	(IMX_PAD_SION | MXRT1170_PAD_PULL_UP)
			IOMUXC_GPIO_SD_B1_04_USDHC1_DATA2	(IMX_PAD_SION | MXRT1170_PAD_PULL_UP)
			IOMUXC_GPIO_SD_B1_03_USDHC1_DATA1	(IMX_PAD_SION | MXRT1170_PAD_PULL_UP)
			IOMUXC_GPIO_SD_B1_02_USDHC1_DATA0	(IMX_PAD_SION | MXRT1170_PAD_PULL_UP)
		>;
	};

	pinctrl_usbotg1_id: otg1idgrp {
		fsl,pins = <
			IOMUXC_GPIO_AD_09_USBPHY1_OTG_ID	(IMX_PAD_SION | MXRT1170_PAD_PUE | MXRT1170_PAD_PUS)
		>;
	};
	pinctrl_usbotg2_id: otg2idgrp {
		fsl,pins = <
			IOMUXC_GPIO_AD_08_USBPHY2_OTG_ID	(IMX_PAD_SION | MXRT1170_PAD_PUE | MXRT1170_PAD_PUS)
		>;
	};

	pinctrl_backlight: backlightgrp {
		fsl,pins = <
			IOMUXC_GPIO_AD_30_GPIO9_IO29		(MXRT1170_PAD_SRE | MXRT1170_PAD_DSE | MXRT1170_PAD_PUE | MXRT1170_PAD_PUS)
		>;
	};

	pinctrl_mipi_dsi_reset: mipi_dsi_reset_grp {
		fsl,pins = <
			IOMUXC_GPIO_AD_02_GPIO9_IO01		(MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
		>;
	};

	pinctrl_mipi_dsi_pwr: mipi_dsi_pwr_grp {
		fsl,pins = <
			IOMUXC_GPIO_DISP_B2_15_GPIO11_IO16	(MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
		>;
	};

	pinctrl_ctp: ctpgrp {
		fsl,pins = <
			/* CTP_INT */
			IOMUXC_GPIO_AD_00_GPIO_MUX2_IO31	(0)
			/* CTP_RST_B */
			IOMUXC_GPIO_AD_01_GPIO9_IO00		(0)
		>;
	};
};

&iomuxc_snvs {
	pinctrl_keys: keysgrp {
		fsl,pins = <
			IOMUXC_WAKEUP_DIG_GPIO13_IO00	(MXRT1170_PAD_DSE | MXRT1170_PAD_PUE | MXRT1170_PAD_PUS)
		>;
	};
};

&iomuxc_lpsr {
	pinctrl_fec1_lpsr: fec1lpsrgrp {
		fsl,pins = <
			/* RST */
			IOMUXC_GPIO_LPSR_12_GPIO12_IO12	(MXRT1170_PAD_DSE | MXRT1170_PAD_PUE)
		>;
	};

	pinctrl_lpi2c5: lpi2cgrp5 {
		fsl,pins = <
			IOMUXC_GPIO_LPSR_05_LPI2C5_SCL	(IMX_PAD_SION | \
							 MXRT1170_PAD_DSE | \
							 MXRT1170_PAD_PUE | \
							 MXRT1170_PAD_PUS | \
							 MXRT1170_PAD_SRE)
			IOMUXC_GPIO_LPSR_04_LPI2C5_SDA	(IMX_PAD_SION | \
							 MXRT1170_PAD_DSE | \
							 MXRT1170_PAD_PUE | \
							 MXRT1170_PAD_PUS | \
							 MXRT1170_PAD_SRE)
		>;
	};
};

&adc1 {
	/* TBD */
	status ="disabled";
};

&adc2 {
	/* TBD */
	status ="disabled";
};

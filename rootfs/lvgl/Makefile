#
# LVGL demos, built from the LVGL sources the distribution ships in
# A2F/lvgl. liblvgl.so is the same for every board; the board-specific
# settings are applied when the demos are linked. Objects stay in obj/.
#

LVGL_VERSION	:= 9.6.0
# Must end in /lvgl: the sources include "lvgl/lvgl.h"
LVGL_DIR	?= $(INSTALL_ROOT)/A2F/lvgl

OBJ_DIR		:= obj

DEMOS		:= stress benchmark widgets music
BINS		:= $(DEMOS)
ifeq ($(MCU), $(filter $(MCU), IMXRT105X_NXPEVK IMXRT106X_NXPEVK))
BINS		+= ebike
# Touch X and Y are swapped on the RT1050/RT1060 EVK panel
SWAP_AXES	:= 1
else
SWAP_AXES	:= 0
endif

CC		:= $(CROSS_COMPILE_APPS)gcc
STRIP		:= $(CROSS_COMPILE_APPS)strip --strip-unneeded
LV_CFLAGS	:= -I$(dir $(LVGL_DIR)) -I. -DLV_CONF_INCLUDE_SIMPLE \
		   -ffunction-sections -fdata-sections -Wall
# Our sources must not use names LVGL keeps only for compatibility
APP_CFLAGS	:= -DLV_DISABLE_API_MAPPING -Wextra -Wno-unused-parameter

all: $(BINS)

ifneq ($(MAKECMDGOALS),clean)

LVGL_FOUND := $(shell sed -n 's/^\#define LVGL_VERSION_\(MAJOR\|MINOR\|PATCH\) *\([0-9]*\).*/\2/p' \
	$(LVGL_DIR)/include/lvgl/lv_version.h $(LVGL_DIR)/lvgl.h 2>/dev/null | head -3 | paste -sd.)
ifneq ($(LVGL_FOUND),$(LVGL_VERSION))
$(error LVGL $(LVGL_VERSION) is required in $(LVGL_DIR), found: '$(LVGL_FOUND)')
endif

# Holds the MCU of the last build; rewritten, and so newer than every
# demo binary, when the MCU changes
MCU_STAMP := $(OBJ_DIR)/.mcu
$(shell mkdir -p $(OBJ_DIR); [ "`cat $(MCU_STAMP) 2>/dev/null`" = "$(MCU)" ] || \
	echo $(MCU) > $(MCU_STAMP))

endif

srcs = $(shell find $(1) -name '*.c' 2>/dev/null)
# $(LVGL_DIR)/x.c -> obj/lvgl/x.o, ebike_ui/x.c -> obj/ebike_ui/x.o
obj = $(patsubst $(LVGL_DIR)/%.c,$(OBJ_DIR)/lvgl/%.o,$(patsubst ebike_ui/%.c,$(OBJ_DIR)/ebike_ui/%.o,$(1)))

LIB_OBJS	:= $(call obj,$(call srcs,$(LVGL_DIR)/src))
# lv_demos.c holds lv_demo_args_init(), used by widgets and music
DEMO_COMMON	:= $(LVGL_DIR)/demos/lv_demos.c

liblvgl.so: $(LIB_OBJS)
	$(CC) -shared -o $@ $^ $(LDFLAGS)
	$(STRIP) $@

stress: $(call obj,$(call srcs,$(LVGL_DIR)/demos/stress))
benchmark: $(call obj,$(DEMO_COMMON) $(call srcs,$(LVGL_DIR)/demos/benchmark $(LVGL_DIR)/demos/widgets))
widgets: $(call obj,$(DEMO_COMMON) $(call srcs,$(LVGL_DIR)/demos/widgets))
music: $(call obj,$(DEMO_COMMON) $(call srcs,$(LVGL_DIR)/demos/music))
ebike: $(call obj,$(call srcs,ebike_ui))

uc = $(shell echo $(1) | tr a-z A-Z)

$(BINS): liblvgl.so main.c $(MCU_STAMP)
	$(CC) $(CFLAGS) $(LV_CFLAGS) $(APP_CFLAGS) -DBUILD_DEMO_$(call uc,$@) \
		-DEVDEV_SWAP_AXES=$(SWAP_AXES) -o $@ \
		$(filter %.o,$^) main.c -L. -llvgl -Wl,--gc-sections $(LDFLAGS)
	$(STRIP) $@

$(OBJ_DIR)/lvgl/%.o: $(LVGL_DIR)/%.c lv_conf.h
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) $(LV_CFLAGS) -c $< -o $@
	@echo "CC $<"

# Generated by SquareLine Studio, which still emits lv_obj_add_flag() and
# lv_obj_remove_flag(), deprecated in LVGL 9.6
$(OBJ_DIR)/ebike_ui/%.o: ebike_ui/%.c lv_conf.h
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) $(LV_CFLAGS) $(APP_CFLAGS) -Wno-deprecated-declarations -c $< -o $@
	@echo "CC $<"

clean:
	rm -rf liblvgl.so $(DEMOS) ebike $(OBJ_DIR)

.PHONY: all clean

/dts-v1/;
#include "stm32h743.dtsi"
#include "stm32h7-pinctrl.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "STMicroelectronics STM32H753i-EVAL board";
	compatible = "st,stm32h753i-eval", "st,stm32h753";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory {
		device_type = "memory";
		reg = <0xd0000000 0x2000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* The framebuffer should be shared between U-Boot and Linux
		   to avoid "display glitches" during boot-up */
		framebuffer {
			reg = <0xd1c00000 0x300000>;
			no-map;
		};

		/* The DMA memory pool is needed by Ethernet and other drivers
		   to allocate buffer descriptors using the standard DMA API */
		dmapool {
			compatible = "shared-dma-pool";
			reg = <0xd1f00000 0x100000>;
			no-map;
			linux,dma-default;
		};
	};

	aliases {
		serial0 = &usart1;
	};

	v2v9_sd: regulator-v2v9_sd {
		compatible = "regulator-fixed";
		regulator-name = "v2v9_sd";
		regulator-min-microvolt = <2900000>;
		regulator-max-microvolt = <2900000>;
		regulator-always-on;
	};

	usbotg_hs_phy: usb-phy {
		#phy-cells = <0>;
		compatible = "usb-nop-xceiv";
		clocks = <&rcc USB1ULPI_CK>;
		clock-names = "main_clk";
	};

	leds {
		compatible = "gpio-leds";
		user-led-1 {
			gpios = <&gpiof 10 GPIO_ACTIVE_LOW>;
		};
		user-led-3 {
			gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		button-tamper {
			label = "button-tamper";
			linux,code = <KEY_A>;
			gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
		};
	};
};

&clk_hse {
	clock-frequency = <25000000>;
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins_a>;
	pinctrl-names = "default";
	i2c-scl-rising-time-ns = <185>;
	i2c-scl-falling-time-ns = <20>;
	status = "okay";

	eeprom@53 {
		compatible = "atmel,24c64";
		reg = <0x53>;
	};
};

&usart1 {
	pinctrl-0 = <&usart1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&mac {
	status = "okay";
	pinctrl-0	= <&ethernet_rmii>;
	pinctrl-names	= "default";
	phy-mode	= "rmii";
	phy-handle	= <&phy0>;

	mdio0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";
		phy0: ethernet-phy@0 {
			reg = <0>;
		};
	};
};

&sdmmc1 {
	pinctrl-names = "default", "opendrain", "sleep";
	pinctrl-0 = <&sdmmc1_b4_pins_a &sdmmc1_dir_pins_a>;
	pinctrl-1 = <&sdmmc1_b4_od_pins_a &sdmmc1_dir_pins_a>;
	pinctrl-2 = <&sdmmc1_b4_sleep_pins_a &sdmmc1_dir_sleep_pins_a>;
	broken-cd;
	st,sig-dir;
	st,neg-edge;
	st,use-ckin;
	bus-width = <4>;
	vmmc-supply = <&v2v9_sd>;
	status = "okay";
};

&usbotg_hs {
	pinctrl-0 = <&usbotg_hs_pins_a>;
	pinctrl-names = "default";
	phys = <&usbotg_hs_phy>;
	phy-names = "usb2-phy";
	dr_mode = "otg";
	status = "okay";
};
